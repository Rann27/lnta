{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**/*.docx" }, { "path": "**/*.md" }]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
